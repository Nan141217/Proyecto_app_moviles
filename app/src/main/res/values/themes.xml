<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Inicio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Popup menu styles -->
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.Menu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.Menu</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Widget.App.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@android:color/white</item>
    </style>

    <style name="TextAppearance.App.Menu" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@android:color/black</item>
    </style>
</resources>